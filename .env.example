# DevPulse AI Environment Variables
LLM_API_KEY=your_openai_or_gemini_api_key_here
LLM_MODEL=gpt-4o
GITHUB_TOKEN=your_optional_github_personal_access_token

# Atlassian Jira REST API Integration (Automated Bug Triage)
JIRA_INTEGRATION_ENABLED=true
JIRA_DOMAIN_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=SCRUM

